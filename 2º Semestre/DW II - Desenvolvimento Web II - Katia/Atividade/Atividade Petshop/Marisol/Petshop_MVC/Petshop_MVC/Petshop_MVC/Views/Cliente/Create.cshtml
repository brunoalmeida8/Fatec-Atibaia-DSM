@model Cliente
@{
    ViewData["Title"] = "Home Cliente";
}
<link rel="stylesheet" href="~/css/"cliente.css" />

<div class="text-center">
    <h1 class="display-4">Cadastro de Clientes</h1>
    <div>
        <form asp-action="Creat">
            <div asp-validation-summary="ModelOnly"></div>
            <div>
                <label asp-for="Nome"></label>
                <input asp-for="Nome" />
                <span asp-validation-for="Nome"></span>
            </div>
            <div>
                <label asp-for="Cpf"></label>
                <input asp-for="Cpf" />
                <span asp-validation-for="Cpf"></span>
            </div>
            <div>
                <label asp-for="Telefone"></label>
                <input asp-for="Telefone" />
                <span asp-validation-for="Telefone"></span>
            </div>
            <div>
                <label asp-for="Email"></label>
                <input asp-for="Email" />
                <span asp-validation-for="Email"></span>
            </div>
        </form>
    </div>
</div>
