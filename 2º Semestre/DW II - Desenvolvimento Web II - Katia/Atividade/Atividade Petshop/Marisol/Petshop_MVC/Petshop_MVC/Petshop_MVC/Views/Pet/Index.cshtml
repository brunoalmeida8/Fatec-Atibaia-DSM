@model IEnumerable<Pet>
@{
    ViewData["Title"] = "Home Pet";
}
<link rel="stylesheet" href="~/css/"pet.css" />

<div class="text-center">
    <h1 class="display-4">Cadastro de Pets</h1>
<p><a asp-action="Create">Cadastrar Pet</a></p>
<table>
    <thead>
        <th>@Html.DisplayNameFor(model => model.Tutor)</th>
        <th>@Html.DisplayNameFor(model => model.Nome)</th>
        <th>@Html.DisplayNameFor(model => model.Especie)</th>
        <th>@Html.DisplayNameFor(model => model.Raca)</th>
        <th>@Html.DisplayNameFor(model => model.DataNascimento)</th>
        <thead>Operações</thead>
    </thead>
    <tbody>
        @foreach(var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Tutor)</td>
                    <td>@Html.DisplayFor(modelItem => item.Nome)</td>
                    <td>@Html.DisplayFor(modelItem => item.Especie)</td>
                    <td>@Html.DisplayFor(modelItem => item.Raca)</td>
                    <td>@Html.DisplayFor(modelItem => item.DataNascimento)</td>
                    <td><a asp-action="Edit" asp-route-id="@item.Id">Editar</a></td>
                    <td><a asp-action="Delete" asp-route-id="@item.Id">Excluir</a></td>
                </tr>
            }
        </tbody>
</table>
</div>
