@model Produto
@{
    ViewData["Title"] = "Cadastrar Produto";
}

<div class="text-center">
    <h1 class="display-4">Cadastro de Produto</h1>
    <div>
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly"></div>
            <div>
                <label asp-for="Nome"></label>
                <input asp-for="Nome" />
                <span asp-validation-for="Nome"></span>
            </div>
            <div>
                <label asp-for="Descricao"></label>
                <input asp-for="Descricao" />
                <span asp-validation-for="Descricao"></span>
            </div>
            <div>
                <label asp-for="Categoria"></label>
                <input asp-for="Categoria" />
                <span asp-validation-for="Categoria"></span>
            </div>
            <div>
                <label asp-for="Preco"></label>
                <input asp-for="Preco" type="number" step="0.01" />
                <span asp-validation-for="Preco"></span>
            </div>
            <div>
                <label asp-for="Observacoes"></label>
                <input asp-for="Observacoes" />
                <span asp-validation-for="Observacoes"></span>
            </div>
            <div>
                <input type="submit" value="Create" />
            </div>
        </form>
    </div>
</div>


<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
