@model Petshop_MVC.Models.Pet

<h1>Editar Pet</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div>
        <label>Tutor:</label>
        <input asp-for="Tutor" />
    </div>
    <div>
        <label>Nome:</label>
        <input asp-for="Nome" />
    </div>
    <div>
        <label>Espécie:</label>
        <input asp-for="Especie" />
    </div>
    <div>
        <label>Raça:</label>
        <input asp-for="Raca" />
    </div>
    <div>
        <label>Data de Nascimento:</label>
        <input asp-for="DataNascimento" type="date" />
    </div>

    <button type="submit">Salvar</button>
    <a asp-action="Index">Voltar</a>
</form>