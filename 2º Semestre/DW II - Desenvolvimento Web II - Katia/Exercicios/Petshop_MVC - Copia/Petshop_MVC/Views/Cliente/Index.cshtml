@model IEnumerable<Cliente>//lista não numerada de clientes
@{
    ViewData["Title"] = "Home Cliente";
}
<link rel="stylesheet" href="~/css/cliente.css" />

<div class="text-center">
    <h1 class="display-4">Cadastro de Clientes</h1>
    <p><a asp-action="Create">Cadastrar Cliente</a></p> <!--direciona para a Create la da controller-->
    <table>
        <thead>
            <th>@Html.DisplayNameFor(model => model.Nome)</th><!-- DisplayNameFor traz o NOME das properties da model-->
            <th>@Html.DisplayNameFor(model => model.Cpf)</th>
            <th>@Html.DisplayNameFor(model => model.Telefone)</th>
            <th>@Html.DisplayNameFor(model => model.Email)</th>
            <thead>Operações</thead>
        </thead>
        <tbody>
            @foreach(var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Nome)</td> <!-- DisplayFor traz o VALOR da propriedade-->
                    <td>@Html.DisplayFor(modelItem => item.Cpf)</td>
                    <td>@Html.DisplayFor(modelItem => item.Telefone)</td>
                    <td>@Html.DisplayFor(modelItem => item.Email)</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.ClienteId">Editar</a>
                    </td>
                    <td>
                        <a asp-action="Delete" asp-route-id="@item.ClienteId">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
