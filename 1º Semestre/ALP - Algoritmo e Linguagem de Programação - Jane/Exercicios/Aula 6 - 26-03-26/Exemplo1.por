// Objetivo: aprender estrutura de repetição enquanto
// Data: 24/03/2026
// Criado por: Bruno Almeida
algoritmo
declare x, y numerico
x <- 1
y <- 5
enquanto x < y faca
	inicio
		x <- x + 2
		y <- y + 1
		escreva "Valor do x: ", x
		escreva "Valor do y: ", y
		escreva "==========="
	fim
fim_algoritmo
