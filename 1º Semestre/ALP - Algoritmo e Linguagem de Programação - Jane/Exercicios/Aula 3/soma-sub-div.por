algoritmo
	declare n1, n2, soma, subtracao, divisao numerico
	
	escreva "digite o primeiro valor"
	leia n1
	escreva "digite o segundo valor"
	leia n2
	soma <- n1+n2
	subtracao <- n1-n2
	divisao <- n1/n2
	escreva "o valor da soma entre ", n1, " e ", n2, " é igual a: ", soma
	escreva "o valor da subtração entre ", n1, " e ", n2, " é igual a: ", subtracao
	escreva "o valor da divisão entre ", n1, " e ", n2, " é igual a: ", divisao
fim_algoritmo
