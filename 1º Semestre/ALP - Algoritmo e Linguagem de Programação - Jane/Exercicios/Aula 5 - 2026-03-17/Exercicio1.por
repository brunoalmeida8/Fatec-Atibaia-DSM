// Objetivo: Tabuada - Estrutura faça
// Data: 17/03/2026
// Criado por: Bruno Almeida
algoritmo
declare i, numero, resultado numerico
escreva "Digite um numero: "
leia numero
para i<-1 ate 10 faca passo 1
	inicio
		resultado <- numero * i
		escreva numero, " x ", i, " = ", resultado
	fim
fim_algoritmo
