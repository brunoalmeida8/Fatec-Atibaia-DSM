// Objetivo: calcular media aritmetica de 10 valores- Estrutura faça
// Data: 17/03/2026
// Criado por: Bruno Almeida
algoritmo
declare i, numero, total, media numerico
para i<-1 ate 10 faca passo 1
	inicio
		escreva "Digite um numero: "
		leia numero
		total <- total + numero
	fim
	media <- total / i
escreva "A media aritmetica é: ", media
fim_algoritmo
